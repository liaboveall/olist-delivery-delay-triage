{
  "config_version": "research-v2.0",
  "schema_version": "2.0.0",
  "description": "Frozen v2 research configuration for data preparation, dual labels, multi-seller dual-clock history, geography cleaning, and temporal splits.",
  "random_seed": 5126,
  "paths": {
    "data_dir": "data",
    "runs_dir": "artifacts/runs"
  },
  "cohort_contract": {
    "source_orders_expected": 99441,
    "cohort_a_delivered_expected": 96470,
    "excluded_unknown_expected": 2971,
    "orders_without_items_expected": 775,
    "non_delivered_with_items_expected": 2196,
    "allow_unknown_outcome_zero_fill": false
  },
  "label_contract": {
    "primary_label": "calendar_day",
    "sensitivity_label": "timestamp",
    "prediction_at_col": "order_purchase_timestamp",
    "label_available_at_col": "order_delivered_customer_date",
    "estimated_delivery_col": "order_estimated_delivery_date",
    "timezone_policy": "preserve_source_naive_local_time",
    "observation_cutoff": "UNKNOWN"
  },
  "feature_version": "base_v2",
  "available_feature_versions": [
    "base_v2",
    "extended_purchase_assumptions_v2"
