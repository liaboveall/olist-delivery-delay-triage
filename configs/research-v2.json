  "geography_contract": {
    "primary_centroid_method": "cleaned_median",
    "sensitivity_centroid_method": "raw_mean",
    "brazil_lat_bounds": [-33.8, 5.4],
    "brazil_lng_bounds": [-74.1, -28.8],
    "deduplicate_exact_rows": true,
    "fallback_hierarchy": [
      "zip_prefix",
      "state_centroid",
      "national_centroid",
      "missing"
    ]
  },
  "history_contract": {
    "event_available_at_col": "order_delivered_customer_date",
    "strict_inequality": "event_available_at < prediction_at",
    "exclude_current_order": true,
    "reject_inverted_timestamps": true,
    "smoothing_alpha": 5.0,
    "default_prior": 0.068,
    "low_history_threshold": 5,
    "multi_seller_aggregation": "mean"
  },
  "calibration_contract": {
    "core_fraction": 0.80,
    "tail_fraction": 0.20,
    "enforce_core_label_maturity": true,
    "refit_full_after_calibration": false,
    "min_tail_samples": 100,
    "min_tail_positives": 10,
    "methods": [
      "uncalibrated",
      "platt",
      "isotonic"
    ]
  },
